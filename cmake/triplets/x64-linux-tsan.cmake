set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_C_FLAGS "-fsanitize=thread -fno-omit-frame-pointer -g")
get_filename_component(NEXORA_TSAN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(VCPKG_CXX_FLAGS "-fsanitize=thread -fno-omit-frame-pointer -g -include ${NEXORA_TSAN_ROOT}/cmake/TsanCompat.h")
set(VCPKG_LINKER_FLAGS "-fsanitize=thread")
