    ('{"_id":"edge_0388_ba","from_id":"Z2","to_id":"Y"}'),
    ('{"_id":"edge_0389_ab","from_id":"Y1","to_id":"Z1"}'),
    ('{"_id":"edge_0389_ba","from_id":"Z1","to_id":"Y1"}');

CREATE LIVE GRAPH professor_social HETEROGENEOUS DIRECTED;
MAP NODE User FROM professor_users KEY _id PROPERTIES username;
MAP EDGE FOLLOWS FROM professor_follows
    SOURCE from_id AS User
    TARGET to_id AS User
    DIRECTED;
BUILD GRAPH professor_social;

GRAPH STATUS professor_social;
RUN LOCK NetworkStats ON professor_social WITH mode='full';
